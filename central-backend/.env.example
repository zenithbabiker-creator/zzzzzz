# Central Backend Configuration (Product 2)
BACKEND_PORT=3001

# PostgreSQL Connection (Docker Compose or external Postgres 15+)
POSTGRES_USER=agritrack
POSTGRES_PASSWORD=
POSTGRES_DB=agritrack_field
POSTGRES_PORT=5432

# Either set DATABASE_URL or individual PG* parameters below:
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=agritrack
PGPASSWORD=
PGDATABASE=agritrack_field
PGSSLMODE=

# Security & Role Secrets (set strong values in production; never commit .env)
SESSION_SECRET=
ADMIN_PASSCODE=
GPS_RETENTION_DAYS=365
